<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.user.atuin-daemon</string>
  <key>ProgramArguments</key><array>
    <string>__ATUIN__</string>
    <string>daemon</string>
    <string>start</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>__HOME__/.local/state/atuin/daemon.out</string>
  <key>StandardErrorPath</key><string>__HOME__/.local/state/atuin/daemon.err</string>
</dict></plist>
