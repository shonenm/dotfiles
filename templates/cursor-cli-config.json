{
  "permissions": {
    "allow": [
      "Shell(find **)",
      "Shell(ls **)",
      "Shell(cat **)",
      "Shell(echo **)",
      "Shell(printf **)",
      "Shell(head **)",
      "Shell(tail **)",
      "Shell(wc **)",
      "Shell(which **)",
      "Shell(type **)",
      "Shell(env **)",
      "Shell(printenv **)",
      "Shell(date **)",
      "Shell(jq **)",
      "Shell(sort **)",
      "Shell(uniq **)",
      "Shell(cut **)",
      "Shell(mkdir **)",
      "Shell(touch **)",
      "Shell(cp **)",
      "Shell(mv **)",
      "Shell(git status**)",
      "Shell(git diff**)",
      "Shell(git log**)",
      "Shell(git show**)",
      "Shell(git branch**)",
      "Shell(gh **)",
      "Read(**)",
      "Write(**)",
      "Glob(**)",
      "Grep(**)",
      "WebSearch(**)",
      "WebFetch(**)",
      "Mcp(**)"
    ],
    "deny": [
      "Shell(rm -rf **)",
      "Shell(sudo **)",
      "Shell(chmod 777 **)",
      "Shell(git push --force**)",
      "Shell(git reset --hard**)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(~/.ssh/id_*)",
      "Read(~/.local/share/ai-notify/**)",
      "Read(**/*_webhook)",
      "Read(**/credentials*)"
    ]
  },
  "editor": {
    "defaultBehavior": "agent"
  },
  "approvalMode": "unrestricted",
  "statusLine": {
    "type": "command",
    "command": "__HOME__/.cursor/statusline-command.sh",
    "padding": 0,
    "updateIntervalMs": 1000,
    "timeoutMs": 2000
  },
  "rewind": true,
  "display": {
    "showStatusLineRunningTime": true
  },
  "attribution": {
    "attributeCommitsToAgent": true,
    "attributePRsToAgent": true
  }
}
