{
  "defaultProvider": "xai",
  "defaultModel": "grok-4.6",
  "defaultThinkingLevel": "medium",
  "subagents": {
    "defaultModel": "openai-codex/gpt-5.4-mini",
    "defaultThinking": "medium",
    "modelScope": {
      "enforce": true,
      "allow": [
        "openai-codex/gpt-5.4-mini"
      ]
    }
  },
  "enabledModels": [
    "openai-codex/*",
    "cursor-agent/*"
  ],
  "hideThinkingBlock": true,
  "theme": "tokyonight-high-contrast",
  "quietStartup": true,
  "collapseChangelog": true,
  "doubleEscapeAction": "tree",
  "treeFilterMode": "no-tools",
  "editorPaddingX": 0,
  "outputPad": 0,
  "autocompleteMaxVisible": 5,
  "showHardwareCursor": false,
  "enableInstallTelemetry": true,
  "shellCommandPrefix": "shopt -s expand_aliases 2>/dev/null\neval \"$(grep '^alias [^-]' ~/.zshrc.common 2>/dev/null)\"",
  "npmCommand": [
    "mise",
    "exec",
    "node@24",
    "--",
    "npm"
  ],
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 20000
  },
  "branchSummary": {
    "reserveTokens": 16384,
    "skipPrompt": false
  },
  "retry": {
    "enabled": true,
    "maxRetries": 3,
    "baseDelayMs": 2000,
    "provider": {
      "timeoutMs": 3600000,
      "maxRetries": 0,
      "maxRetryDelayMs": 60000
    }
  },
  "steeringMode": "one-at-a-time",
  "followUpMode": "one-at-a-time",
  "transport": "sse",
  "terminal": {
    "showImages": true,
    "imageWidthCells": 60,
    "clearOnShrink": false
  },
  "images": {
    "autoResize": true,
    "blockImages": false
  },
  "warnings": {
    "anthropicExtraUsage": true
  },
  "markdown": {
    "codeBlockIndent": "  "
  },
  "enableSkillCommands": true,
  "skills": [
    "~/.config/agent/skills",
    "~/.pi/agent/skills",
    "~/.claude/skills"
  ],
  "extensions": [
    "~/.pi/agent/extensions"
  ],
  "prompts": [
    "~/.pi/agent/prompts"
  ],
  "themes": [],
  "packages": [
    "npm:pi-subagents",
    "npm:@quintinshaw/pi-dynamic-workflows",
    "npm:@trevonistrevon/pi-loop",
    "npm:@narumitw/pi-goal",
    "npm:pi-remote-control",
    "npm:pi-cursor-agent",
    "npm:pi-permission-system",
    "npm:@czottmann/pi-automode",
    "git:github.com/DietrichGebert/ponytail",
    {
      "source": "npm:pi-open-tui",
      "extensions": [
        "!extensions/open-tui/index.ts"
      ]
    },
    "npm:awesome-pi-themes",
    "npm:pi-studio",
    "npm:pi-extmgr",
    {
      "source": "npm:pi-beautiful-tui",
      "extensions": [
        "!index.ts"
      ]
    },
    {
      "source": "npm:pi-agent-extensions",
      "extensions": [
        "!extensions/powerline-footer/index.ts",
        "!extensions/whimsical/index.ts",
        "!extensions/workflow/index.ts"
      ]
    },
    {
      "source": "npm:pi-system-theme",
      "extensions": [
        "!index.ts"
      ]
    },
    {
      "source": "git:github.com/tomsej/pi-ext",
      "extensions": [
        "!extensions/custom-footer/custom-footer.ts",
        "!extensions/permissions/permissions.ts"
      ]
    }
  ],
  "lastChangelogVersion": "0.84.1"
}