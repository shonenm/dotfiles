#!/usr/bin/env bash
set -euo pipefail

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
command -v mise >/dev/null 2>&1 || { echo "update-mise-lock: mise is required" >&2; exit 1; }

if [[ -z "${GITHUB_TOKEN:-}" ]] && command -v gh >/dev/null 2>&1; then
  GITHUB_TOKEN=$(gh auth token 2>/dev/null || true)
  export GITHUB_TOKEN
fi

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
mkdir -p "$tmp/mise/conf.d" "$tmp/cache"
cp "$root/common/mise/.config/mise/config.toml" "$tmp/mise/config.toml"
cp "$root/config/mise-linux.toml" "$tmp/mise/conf.d/dotfiles-linux.toml"

platforms=linux-x64,linux-arm64,macos-x64,macos-arm64
tool_count=$(python3 - "$root" <<'PY'
import pathlib, sys, tomllib
root = pathlib.Path(sys.argv[1])
print(sum(
    len(tomllib.loads(path.read_text())["tools"])
    for path in (
        root / "common/mise/.config/mise/config.toml",
        root / "config/mise-linux.toml",
    )
))
PY
)
echo "Locking $tool_count tools for ${platforms//,/, }"

# ponytail: keep clx progress (stderr TTY). --quiet would also kill it.
# Drop mise's one-line tool dump / tmp lock path; hide info! provenance downloads.
MISE_LOG_LEVEL="${MISE_LOG_LEVEL:-warn}" \
XDG_CONFIG_HOME="$tmp" XDG_CACHE_HOME="$tmp/cache" \
  mise lock -g -y --bump --platform "$platforms" \
  > >(python3 -c '
import re, sys
pat = re.compile(r"Targeting .*platform|Processing .*tool|Lockfile written to")
for line in sys.stdin:
    if not pat.search(line):
        sys.stdout.write(line)
')

python3 - "$root" "$tmp/mise/mise.lock" <<'PY'
import pathlib, sys, tomllib

root = pathlib.Path(sys.argv[1])
with open(sys.argv[2], "rb") as f:
    lock = tomllib.load(f)
assert lock.get("tools"), "mise lockfile contains no tools"

configs = (
    (root / "common/mise/.config/mise/config.toml", {"linux-x64", "linux-arm64", "macos-x64", "macos-arm64"}),
    (root / "config/mise-linux.toml", {"linux-x64", "linux-arm64"}),
)
for path, required in configs:
    config = tomllib.loads(path.read_text())
    for name in config["tools"]:
        entries = lock["tools"].get(name.split("[", 1)[0], [])
        assert entries, f"mise lockfile is missing {name}"
        platforms = {key.removeprefix("platforms.") for entry in entries for key in entry if key.startswith("platforms.")}
        backends = {entry.get("backend", "") for entry in entries}
        if not platforms and all(backend.startswith(("cargo:", "npm:")) for backend in backends):
            continue
        missing = required - platforms
        assert not missing, f"mise lockfile is missing {name} platforms: {', '.join(sorted(missing))}"
PY
# mise records `provenance_verified` only for the host running `mise lock`, so
# it flips between macOS and Linux on every run and causes ping-pong commits.
# Drop it here; per-host cryptographic verification is enforced at install time
# via `locked_verify_provenance` instead. The stable `provenance = ...` lines
# (from registry metadata, identical across hosts) still guard downgrades.
sed '/^provenance_verified = /d' "$tmp/mise/mise.lock" > "$tmp/mise/mise.lock.stable"
mv "$tmp/mise/mise.lock.stable" "$tmp/mise/mise.lock"

cp "$tmp/mise/mise.lock" "$root/common/mise/.config/mise/mise.lock"
echo "Updated common/mise/.config/mise/mise.lock"
