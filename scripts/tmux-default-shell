#!/usr/bin/env bash
# Shared tmux / TUIOS shell resolver and command runner.
# ~/.nix-profile/bin/zsh accessible → already inside chroot or native nix.
# Not accessible + nix-user-chroot present → enter chroot first.
# User tools are needed even when SSH starts the daemon with a system-only PATH.
export PATH="$HOME/.local/bin:$HOME/.pixi/bin:$HOME/.local/share/mise/shims:$PATH"
# A TUIOS session registered by `tui rcon` opens each pane shell in its container.
# REVIEW: rcon check runs before the ralph-crew resume rewrite, so a restored pane in an rcon session enters the container and skips the resume file.
if [ $# -eq 0 ] && [ -z "${TMUX:-}" ] && [ -n "${TUIOS_SESSION:-}" ]; then
  _rcon="${XDG_STATE_HOME:-$HOME/.local/state}/tuios-rcon/$TUIOS_SESSION"
  if [ -r "$_rcon" ]; then
    exec "$(dirname "$0")/tmux-docker-enter" "$(cat "$_rcon")"
  fi
fi
# A TUIOS-restored pane resumes what ralph-crew daemon recorded for it
# (tmux @resurrect-processes equivalent), then stays an interactive shell.
_resume="${XDG_STATE_HOME:-$HOME/.local/state}/ralph-crew/tuios-resume/${TUIOS_PANE_ID:-}"
if [ $# -eq 0 ] && [ -n "${TUIOS_RESTORED:-}" ] && [ -n "${TUIOS_PANE_ID:-}" ] && [ -f "$_resume" ]; then
  set -- -ic ". '$_resume'; exec \"\$0\" -i"
fi
# Fallback to user/system zsh or bash.
_nix_zsh="$HOME/.nix-profile/bin/zsh"
if [ -x "$_nix_zsh" ]; then
  exec "$_nix_zsh" "$@"
elif [ -x "$HOME/.local/bin/nix-user-chroot" ] && [ -d "$HOME/.nix-store/nix" ]; then
  exec "$HOME/.local/bin/nix-user-chroot" "$HOME/.nix-store/nix" "$_nix_zsh" "$@"
else
  exec "$(command -v zsh 2>/dev/null || echo /bin/bash)" "$@"
fi
