#!/usr/bin/env bash
set -euo pipefail

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$root"

for cmd in git python3 shellcheck stow; do
  command -v "$cmd" >/dev/null 2>&1 || { echo "check: missing required command: $cmd" >&2; exit 1; }
done

shell_files=()
while IFS= read -r file; do
  [[ -f "$file" ]] || continue
  case "$file" in
    common/zsh/*|linux/zsh/*|mac/zsh/*|config/*) continue ;;
    *.sh) shell_files+=("$file") ;;
    scripts/*)
      case "$(head -n 1 "$file")" in '#!'*bash*|'#!'*/sh) shell_files+=("$file") ;; esac
      ;;
  esac
done < <(git ls-files)
shellcheck -S warning -e SC1090 -e SC1091 "${shell_files[@]}"

scripts/test-install-fast-paths.sh
[[ ! -x scripts/test-pi-tui-patch.sh ]] || scripts/test-pi-tui-patch.sh
[[ ! -x scripts/test-pi-automode-patch.sh ]] || scripts/test-pi-automode-patch.sh
scripts/test-harness-entrypoints.sh
scripts/test-codex-config.sh
scripts/test-cursor-config.sh
scripts/test-pi-permission-gate.sh
python3 scripts/test-tmux-layout.py
[[ -z "$(command -v tmux)" ]] || scripts/test-tmux-zoom.sh
scripts/test-statusline-render.sh
python3 scripts/test_check_markdown_links.py
scripts/check-markdown-links.py
scripts/check-doc-provenance.py
scripts/check-package-duplication.sh

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
for dir in common/*/; do
  if ! output=$(stow --dir=common --target="$tmp" --no-folding --no "$(basename "$dir")" 2>&1); then
    printf '%s\n' "$output" >&2
    exit 1
  fi
done

git diff --check
echo "repository checks: OK"
