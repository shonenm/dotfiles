#!/usr/bin/env python3
"""TUIOS launcher, project picker and native-space settings/navigation."""

import argparse
import hashlib
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys


def run(*args, **kwargs):
    return subprocess.run(args, check=True, **kwargs)


def sessions():
    result = subprocess.run(["tuios", "ls", "--json"], capture_output=True, text=True)
    # Exit 3 lists saved sessions when no daemon is running, including [].
    if result.returncode not in (0, 3):
        raise RuntimeError(result.stderr.strip() or f"tuios ls exited {result.returncode}")
    return json.loads(result.stdout)


def choose(lines, prompt):
    result = subprocess.run(
        ["fzf", "--reverse", "--border", f"--prompt={prompt}> ", "--delimiter=\t", "--with-nth=2.."],
        input="\n".join(lines), stdout=subprocess.PIPE, text=True,
    )
    if result.returncode in (1, 130):
        return None
    result.check_returncode()
    return result.stdout.rstrip("\n").split("\t", 1)[0]


def session_name(path):
    path = str(Path(path).resolve())
    name = re.sub(r"[^a-zA-Z0-9_-]", "-", Path(path).name)[:40] or "root"
    return f"{name}-{hashlib.sha256(path.encode()).hexdigest()[:8]}"


def switch_session(*args):
    result = subprocess.run(["tuios", "switch-session", *args], capture_output=True, text=True)
    if result.returncode:
        # A linked host cannot switch the local client's view. Leave that
        # choice to the native picker, which receives the user's own key.
        if "refused: switch_session came from host " in result.stderr:
            print(f"Session {args[-1]}: Ctrl+Space s で選択", flush=True)
            if sys.stdin.isatty():
                try:
                    input("Enterで閉じる: ")
                except (EOFError, KeyboardInterrupt):
                    pass
            return
        raise RuntimeError(result.stderr.strip() or f"tuios switch-session exited {result.returncode}")


def connect(name, cwd=None):
    if os.environ.get("TUIOS_SESSION"):
        args = ["--create"]
        if cwd is not None:
            args.extend(["--cwd", str(cwd)])
        switch_session(*args, name)
    else:
        if cwd is not None:
            os.chdir(cwd)
        os.execvp("tuios", ["tuios", "attach", "--create", name])


def pick():
    paths = [str(Path.home()), str(Path.home() / "dotfiles")]
    for command in (("ghq", "list", "--full-path"), ("zoxide", "query", "--list")):
        if not shutil.which(command[0]):
            continue
        paths.extend(run(*command, capture_output=True, text=True).stdout.splitlines())
    paths = list(dict.fromkeys(path for path in paths if Path(path).is_dir()))
    selected = choose([f"{index}\t{path}" for index, path in enumerate(paths)], "project")
    if selected is not None:
        path = paths[int(selected)]
        connect(session_name(path), path)


def space():
    rows = sessions()
    spaces = sorted({r.get("space", "") for r in rows} - {""})
    chosen = choose(["new\tCreate space", "clear\tRemove from space"] + [f"space:{name}\t{name}" for name in spaces], "space")
    if not chosen:
        return
    if chosen == "clear":
        args = []
    elif chosen == "new":
        name = input("New space: ").strip()
        if not name:
            return
        args = [name]
    else:
        args = [chosen.removeprefix("space:")]
    run("tuios", "set-session-space", *args)


def navigate_space(direction, client_pid):
    # The shell keybinding passes its client's PID. Session names alone can
    # target another client, and the local daemon has no attach while remote.
    clients = json.loads(run("tuios", "list-clients", "--json", capture_output=True, text=True).stdout)
    clients = [row for row in clients if row["pid"] == client_pid and row["session"]]
    if not clients:
        return
    if len(clients) != 1:
        raise RuntimeError("space navigation requires one attached session for this client")
    client = clients[0]
    rows = sorted(sessions(), key=lambda row: (row.get("space", ""), row["name"]))
    current = next((row for row in rows if row["name"] == client["session"]), None)
    if current is None:
        raise RuntimeError("client session is not in the live session listing")
    spaces = list(dict.fromkeys(row.get("space", "") for row in rows))
    if len(spaces) < 2:
        return
    delta = 1 if direction == "next" else -1
    target = spaces[(spaces.index(current.get("space", "")) + delta) % len(spaces)]
    candidates = [row for row in rows if row.get("space", "") == target]
    destination = max(candidates, key=lambda row: row["last_active"])
    run("tuios", "switch-session", "--client", client["client_id"], destination["name"])


AGENT_COLORS = {"working": 33, "needs_input": 31, "errored": 31, "done": 32, "hang": 35}
# tmux-claude-pane.sh と同じ閾値。hookのreportごとに更新されるevidenceだけで判定する。
HANG_THRESHOLD_MS = int(os.environ.get("AGENT_HANG_THRESHOLD", "120")) * 1000


def agent_state(pane):
    # working のまま hook の report が途絶えた pane を hang と推定する。
    age = pane.get("evidence_age_ms")
    if pane["state"] == "working" and age is not None and age >= HANG_THRESHOLD_MS:
        return "hang"
    return pane["state"]


def rail():
    # Rows for the rail's custom section: agents per session, then the branch
    # of its focused pane. `tuios ls` keeps the branch from session creation.
    panes = json.loads(run("tuios", "list-agents", "--all", "--all-sessions", "--json", capture_output=True, text=True).stdout)["agents"]
    for row in sorted(sessions(), key=lambda row: (row.get("space", ""), row["name"])):
        own = sorted((p for p in panes if p["session"] == row["name"]), key=lambda p: not p["focused"])
        states = [agent_state(p) for p in own if p["harness_id"]]
        dots = "".join(f"\033[{AGENT_COLORS.get(state, 90)}m●\033[0m" for state in states)
        print(f"{row['name']} {len(states)} {dots}" if states else row["name"])
        cwd = next((p["cwd"] for p in own if p["cwd"]), None)
        branch = cwd and subprocess.run(["git", "-C", cwd, "branch", "--show-current"], capture_output=True, text=True).stdout.strip()
        if branch:
            print(f"  \033[90m└ {branch}\033[0m")


def root():
    result = run("git", "rev-parse", "--show-toplevel", capture_output=True, text=True)
    path = result.stdout.strip()
    connect(session_name(path), path)


def dev():
    info = json.loads(run("tuios", "list-workspaces", "--json", capture_output=True, text=True).stdout)
    if not any(row["window_count"] == 0 for row in info["workspaces"]):
        raise RuntimeError("every workspace has a pane; dev layout was not opened")
    path = Path(os.environ.get("XDG_CONFIG_HOME", str(Path.home() / ".config"))) / "tuios/dev.tape"
    run("tuios", "tape", "exec", str(path))


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest="command")
    for name in ("pick", "space", "root", "dev", "rail"):
        sub.add_parser(name)
    nav = sub.add_parser("space-nav")
    nav.add_argument("direction", choices=("next", "prev"))
    nav.add_argument("client_pid", type=int)
    attach = sub.add_parser("attach")
    attach.add_argument("name", nargs="?", default="main")
    attach.add_argument("--cwd", type=Path, default=Path.cwd())
    args = parser.parse_args()
    try:
        if args.command is None:
            if os.environ.get("TUIOS_SESSION"):
                run("tuios", "run-command", "prefix_session_switcher")
            else:
                os.execvp("tuios", ["tuios"])
        elif args.command == "attach":
            connect(args.name, args.cwd)
        elif args.command == "pick":
            pick()
        elif args.command == "space":
            space()
        elif args.command == "space-nav":
            navigate_space(args.direction, args.client_pid)
        elif args.command == "rail":
            rail()
        elif args.command == "root":
            root()
        elif args.command == "dev":
            dev()
    except (OSError, ValueError, RuntimeError, subprocess.CalledProcessError) as error:
        print(f"tui: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
