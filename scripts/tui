#!/usr/bin/env python3
"""TUIOS launcher, project picker and native-space settings."""

import argparse
import hashlib
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys


def run(*args, **kwargs):
    return subprocess.run(args, check=True, **kwargs)


def sessions():
    result = subprocess.run(["tuios", "ls", "--json"], capture_output=True, text=True)
    # Exit 3 lists saved sessions when no daemon is running, including [].
    if result.returncode not in (0, 3):
        raise RuntimeError(result.stderr.strip() or f"tuios ls exited {result.returncode}")
    return json.loads(result.stdout)


def choose(lines, prompt):
    result = subprocess.run(
        ["fzf", "--reverse", "--border", f"--prompt={prompt}> ", "--delimiter=\t", "--with-nth=2.."],
        input="\n".join(lines), stdout=subprocess.PIPE, text=True,
    )
    if result.returncode in (1, 130):
        return None
    result.check_returncode()
    return result.stdout.rstrip("\n").split("\t", 1)[0]


def session_name(path):
    path = str(Path(path).resolve())
    name = re.sub(r"[^a-zA-Z0-9_-]", "-", Path(path).name)[:40] or "root"
    return f"{name}-{hashlib.sha256(path.encode()).hexdigest()[:8]}"


def switch_session(*args):
    result = subprocess.run(["tuios", "switch-session", *args], capture_output=True, text=True)
    if result.returncode:
        # A linked host cannot switch the local client's view. Leave that
        # choice to the native picker, which receives the user's own key.
        if "refused: switch_session came from host " in result.stderr:
            print(f"Session {args[-1]}: Ctrl+Space s で選択", flush=True)
            if sys.stdin.isatty():
                try:
                    input("Enterで閉じる: ")
                except (EOFError, KeyboardInterrupt):
                    pass
            return
        raise RuntimeError(result.stderr.strip() or f"tuios switch-session exited {result.returncode}")


def connect(name, cwd=None):
    if os.environ.get("TUIOS_SESSION"):
        args = ["--create"]
        if cwd is not None:
            args.extend(["--cwd", str(cwd)])
        switch_session(*args, name)
    else:
        if cwd is not None:
            os.chdir(cwd)
        os.execvp("tuios", ["tuios", "attach", "--create", name])


def pick():
    paths = [str(Path.home()), str(Path.home() / "dotfiles")]
    for command in (("ghq", "list", "--full-path"), ("zoxide", "query", "--list")):
        if not shutil.which(command[0]):
            continue
        paths.extend(run(*command, capture_output=True, text=True).stdout.splitlines())
    paths = list(dict.fromkeys(path for path in paths if Path(path).is_dir()))
    selected = choose([f"{index}\t{path}" for index, path in enumerate(paths)], "project")
    if selected is not None:
        path = paths[int(selected)]
        connect(session_name(path), path)


def space():
    rows = sessions()
    spaces = sorted({r.get("space", "") for r in rows} - {""})
    chosen = choose(["new\tCreate space", "clear\tRemove from space"] + [f"space:{name}\t{name}" for name in spaces], "space")
    if not chosen:
        return
    if chosen == "clear":
        args = []
    elif chosen == "new":
        name = input("New space: ").strip()
        if not name:
            return
        args = [name]
    else:
        args = [chosen.removeprefix("space:")]
    run("tuios", "set-session-space", *args)


def root():
    result = run("git", "rev-parse", "--show-toplevel", capture_output=True, text=True)
    path = result.stdout.strip()
    connect(session_name(path), path)


def dev():
    info = json.loads(run("tuios", "list-workspaces", "--json", capture_output=True, text=True).stdout)
    if not any(row["window_count"] == 0 for row in info["workspaces"]):
        raise RuntimeError("every workspace has a pane; dev layout was not opened")
    path = Path(os.environ.get("XDG_CONFIG_HOME", str(Path.home() / ".config"))) / "tuios/dev.tape"
    run("tuios", "tape", "exec", str(path))


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest="command")
    for name in ("pick", "space", "root", "dev"):
        sub.add_parser(name)
    attach = sub.add_parser("attach")
    attach.add_argument("name", nargs="?", default="main")
    attach.add_argument("--cwd", type=Path, default=Path.cwd())
    args = parser.parse_args()
    try:
        if args.command is None:
            if os.environ.get("TUIOS_SESSION"):
                run("tuios", "run-command", "prefix_session_switcher")
            else:
                os.execvp("tuios", ["tuios"])
        elif args.command == "attach":
            connect(args.name, args.cwd)
        elif args.command == "pick":
            pick()
        elif args.command == "space":
            space()
        elif args.command == "root":
            root()
        elif args.command == "dev":
            dev()
    except (OSError, ValueError, RuntimeError, subprocess.CalledProcessError) as error:
        print(f"tui: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
