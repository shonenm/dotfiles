#!/usr/bin/env bash
set -euo pipefail

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
command=${1:-help}
[[ $# -eq 0 ]] || shift

case "$command" in
  apply)
    exec "$root/install.sh" "$@"
    ;;
  update)
    git -C "$root" pull --ff-only
    "$root/scripts/update-mise-lock"
    exec "$root/install.sh" --update "$@"
    ;;
  check)
    exec "$root/scripts/check" "$@"
    ;;
  doctor)
    failed=0
    echo "==> Required tools"
    for cmd in zsh tmux nvim starship sheldon atuin zoxide fzf fd rg bat eza ghq mise stow; do
      if command -v "$cmd" >/dev/null 2>&1; then
        printf '  ✓ %s (%s)\n' "$cmd" "$(command -v "$cmd")"
      else
        printf '  ✗ %s NOT FOUND\n' "$cmd"
        failed=1
      fi
    done
    if ! command -v stow >/dev/null 2>&1; then
      exit "$failed"
    fi
    echo
    echo "==> Stow links"
    for dir in "$root"/common/*/; do
      pkg=$(basename "$dir")
      if output=$(stow --dir="$root/common" --target="$HOME" --no-folding --no "$pkg" 2>&1); then
        printf '  ✓ %s\n' "$pkg"
      elif grep -q CONFLICT <<< "$output"; then
        printf '  ⚠ %s has conflicts\n' "$pkg"
        failed=1
      else
        printf '  ✗ %s check failed: %s\n' "$pkg" "$output"
        failed=1
      fi
    done
    exit "$failed"
    ;;
  lock)
    exec "$root/scripts/update-mise-lock" "$@"
    ;;
  help|-h|--help)
    cat <<'EOF'
Usage: dots <command> [options]

  apply    Apply package declarations and dotfile links
  update   Fast-forward the repository, then apply refreshed dependencies
  check    Run the same repository checks as CI
  doctor   Check installed tools and Stow conflicts
  lock     Refresh the cross-platform mise lockfile
EOF
    ;;
  *)
    echo "dots: unknown command: $command" >&2
    echo "Run 'dots help' for usage." >&2
    exit 2
    ;;
esac
