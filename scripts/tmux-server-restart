#!/usr/bin/env bash
# tmux server restart with layout, session-group, container, and agent recovery.
#
# Usage:
#   tmux-server-restart [host] [--yes]
#   tmux-server-restart [host] --dry-run
#
# The local mode invokes the same script on the remote host, so the restart
# happens outside tmux and the SSH tty can attach to the restored session.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REMOTE=false
ASSUME_YES=false
DRY_RUN=false
NO_ATTACH=false
SNAPSHOT_DIR_ARG=""
ATTACH_WINDOW=0
HOST="ailab"
HOST_SET=false

usage() {
  cat <<'EOF'
Usage: tmux-server-restart [host] [options]

Restart a remote tmux server and recover its saved layout, groups, containers,
and AI agent sessions.

Options:
  -y, --yes       Skip the confirmation prompt
      --dry-run   Show the current inventory without changing anything
      --snapshot=DIR  Restore a previously saved snapshot without saving again
      --no-attach Restore and exit instead of attaching to the session
  -h, --help      Show this help
EOF
}

for arg in "$@"; do
  case "$arg" in
    --remote) REMOTE=true ;;
    -y|--yes) ASSUME_YES=true ;;
    --dry-run) DRY_RUN=true ;;
    --snapshot=*) SNAPSHOT_DIR_ARG="${arg#--snapshot=}" ;;
    --no-attach) NO_ATTACH=true ;;
    -h|--help) usage; exit 0 ;;
    --*) echo "Unknown option: $arg" >&2; usage >&2; exit 2 ;;
    *)
      if [[ "$REMOTE" == false && "$HOST_SET" == false ]]; then
        HOST="$arg"
        HOST_SET=true
      else
        echo "Unexpected argument: $arg" >&2; usage >&2; exit 2
      fi
      ;;
  esac
done

if [[ "$REMOTE" == false ]]; then
  if [[ "$ASSUME_YES" == false && "$DRY_RUN" == false ]]; then
    printf 'Restart tmux server on %s and restore its sessions? [y/N] ' "$HOST" >&2
    read -r answer
    [[ "$answer" =~ ^[Yy]([Ee][Ss])?$ ]] || { echo 'Cancelled.' >&2; exit 0; }
  fi

  remote_args=(--remote --yes)
  [[ "$DRY_RUN" == true ]] && remote_args+=(--dry-run)
  [[ "$NO_ATTACH" == true ]] && remote_args+=(--no-attach)
  [[ -n "$SNAPSHOT_DIR_ARG" ]] && remote_args+=("--snapshot=$SNAPSHOT_DIR_ARG")
  # rcon's PATH is required: /usr/bin/tmux on ailab is the incompatible 3.2a.
  remote_command="export PATH=\"\$HOME/.local/bin:\$HOME/.pixi/bin:\$PATH\"; export TERMINFO_DIRS=\"\$HOME/.terminfo:/usr/share/terminfo:/lib/terminfo\"; exec \"\$HOME/dotfiles/scripts/tmux-server-restart\""
  for remote_arg in "${remote_args[@]}"; do
    remote_command+=" $(printf '%q' "$remote_arg")"
  done
  exec ssh -tt "$HOST" "$remote_command"
fi

[[ -z "${TMUX:-}" ]] || {
  echo 'tmux-server-restart: run from outside the target tmux server.' >&2
  exit 1
}

if [[ "$ASSUME_YES" == false && "$DRY_RUN" == false ]]; then
  printf 'Restart this tmux server and restore its sessions? [y/N] ' >&2
  read -r answer
  [[ "$answer" =~ ^[Yy]([Ee][Ss])?$ ]] || { echo 'Cancelled.' >&2; exit 0; }
fi

export PATH="$HOME/.local/bin:$HOME/.pixi/bin:$PATH"
export TERMINFO_DIRS="$HOME/.terminfo:/usr/share/terminfo:/lib/terminfo"
if zsh_bin=$(command -v zsh 2>/dev/null); then
  export SHELL="$zsh_bin"
fi

TMUX_BIN="$(command -v tmux 2>/dev/null || true)"
[[ -n "$TMUX_BIN" ]] || { echo 'tmux-server-restart: tmux not found' >&2; exit 1; }
RESURRECT_DIR="${TMUX_RESURRECT_DIR:-$HOME/.tmux/plugins/tmux-resurrect}"
SAVE_SCRIPT="${TMUX_RESURRECT_SAVE_SCRIPT:-$RESURRECT_DIR/scripts/save.sh}"
RESTORE_SCRIPT="${TMUX_RESURRECT_RESTORE_SCRIPT:-$RESURRECT_DIR/scripts/restore.sh}"
STATE_DIR="${TMUX_RESTART_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/tmux/restart}"
US=$'\x1f'
TMUX_SOCKET="${TMUX_RESTART_SOCKET:-${TMUX_TMPDIR:-/tmp}/tmux-$(id -u)/default}"

fatal() {
  echo "tmux-server-restart: $*" >&2
  exit 1
}

count_lines() {
  awk 'NF { n++ } END { print n + 0 }'
}

shell_quote() {
  printf '%q' "$1"
}

has_session() {
  "$TMUX_BIN" has-session -t "$1" 2>/dev/null
}

remove_stale_socket() {
  [[ -S "$TMUX_SOCKET" ]] || return 0
  "$TMUX_BIN" list-sessions >/dev/null 2>&1 && return 0
  echo "Removing stale tmux socket: $TMUX_SOCKET" >&2
  rm -f "$TMUX_SOCKET"
}

start_server() {
  has_session "$ATTACH_SESSION" && return 0
  if ! "$TMUX_BIN" new-session -d -s "$ATTACH_SESSION" -c "$ATTACH_CWD"; then
    has_session "$ATTACH_SESSION" && return 0
    echo 'tmux server startup failed; retrying after stale-socket cleanup.' >&2
    remove_stale_socket
    "$TMUX_BIN" new-session -d -s "$ATTACH_SESSION" -c "$ATTACH_CWD"
  fi
  if [[ "$ATTACH_WINDOW" != 0 ]]; then
    "$TMUX_BIN" move-window -s "$ATTACH_SESSION:0" -t "$ATTACH_SESSION:$ATTACH_WINDOW" 2>/dev/null || true
  fi
}

load_snapshot_meta() {
  ATTACH_SESSION=$(awk -F '\t' '$1 == "attach_session" { print $2; exit }' "$SNAPSHOT_DIR/meta.tsv")
  ATTACH_CWD=$(awk -F '\t' '$1 == "attach_cwd" { print $2; exit }' "$SNAPSHOT_DIR/meta.tsv")
  ATTACH_WINDOW=$(awk -F '\t' '$1 == "attach_window" { print $2; exit }' "$SNAPSHOT_DIR/meta.tsv")
  [[ "$ATTACH_WINDOW" =~ ^[0-9]+$ ]] ||
    ATTACH_WINDOW=$(awk -F "$US" -v s="$ATTACH_SESSION" '$1 == s { print $2; exit }' "$SNAPSHOT_DIR/windows.tsv")
  [[ "$ATTACH_WINDOW" =~ ^[0-9]+$ ]] || ATTACH_WINDOW=0
  EXPECTED_SESSIONS=$(awk -F '\t' '$1 == "sessions" { print $2; exit }' "$SNAPSHOT_DIR/meta.tsv")
  EXPECTED_PANES=$(awk -F '\t' '$1 == "panes" { print $2; exit }' "$SNAPSHOT_DIR/meta.tsv")
  [[ -n "$ATTACH_SESSION" && "$EXPECTED_SESSIONS" =~ ^[0-9]+$ && "$EXPECTED_PANES" =~ ^[0-9]+$ ]] ||
    fatal "invalid snapshot metadata: $SNAPSHOT_DIR/meta.tsv"
  [[ -d "$ATTACH_CWD" ]] || ATTACH_CWD="$HOME"
}

snapshot_state() {
  local stamp
  umask 077
  mkdir -p "$STATE_DIR"
  stamp="$(date +%Y%m%d-%H%M%S)-$$"
  SNAPSHOT_DIR="$STATE_DIR/$stamp"
  TMUX_BIN="$TMUX_BIN" TMUX_RESTART_STATE_DIR="$STATE_DIR" \
    "$SCRIPT_DIR/tmux-restore-extras.sh" save "$SNAPSHOT_DIR" ||
    fatal "failed to save extras snapshot: $SNAPSHOT_DIR"
  load_snapshot_meta
  echo "Snapshot: $SNAPSHOT_DIR"
  echo "Sessions: $EXPECTED_SESSIONS, panes: $EXPECTED_PANES"
}

show_inventory() {
  local panes
  panes=$("$TMUX_BIN" list-panes -a -F \
    '#{session_name}|#{window_index}.#{pane_index}|#{pane_current_command}|#{@agent_provider}|#{pane_current_path}' 2>/dev/null || true)
  printf '%s\n' "$panes"
}

restore_layout() {
  local sessions panes
  # continuum starts restore one second after the new server loads. Give it
  # ownership first, then use the plugin script only when it did not restore.
  sleep 2
  for _ in $(seq 1 30); do
    sessions=$("$TMUX_BIN" list-sessions 2>/dev/null | count_lines)
    panes=$("$TMUX_BIN" list-panes -a 2>/dev/null | count_lines)
    if (( sessions >= EXPECTED_SESSIONS && panes >= EXPECTED_PANES )); then
      echo "Layout restored: $sessions sessions, $panes panes"
      return 0
    fi
    sleep 1
  done

  if [[ -x "$RESTORE_SCRIPT" ]]; then
    echo 'Automatic restore did not reach the saved topology; running restore.sh.' >&2
    if ! "$RESTORE_SCRIPT"; then
      echo 'Warning: restore.sh failed; continuing with the partial restore.' >&2
    fi
    for _ in $(seq 1 10); do
      sessions=$("$TMUX_BIN" list-sessions 2>/dev/null | count_lines)
      panes=$("$TMUX_BIN" list-panes -a 2>/dev/null | count_lines)
      if (( sessions >= EXPECTED_SESSIONS && panes >= EXPECTED_PANES )); then
        echo "Layout restored: $sessions sessions, $panes panes"
        return 0
      fi
      sleep 1
    done
  fi

  echo 'Warning: restored topology is smaller than the snapshot.' >&2
  "$TMUX_BIN" list-sessions >&2 || true
}

load_snapshot() {
  SNAPSHOT_DIR="$SNAPSHOT_DIR_ARG"
  [[ -d "$SNAPSHOT_DIR" ]] || fatal "snapshot directory not found: $SNAPSHOT_DIR"
  [[ -f "$SNAPSHOT_DIR/meta.tsv" && -f "$SNAPSHOT_DIR/sessions.tsv" && -f "$SNAPSHOT_DIR/panes.tsv" ]] ||
    fatal "incomplete snapshot: $SNAPSHOT_DIR"
  load_snapshot_meta
  echo "Using snapshot: $SNAPSHOT_DIR"
  echo "Sessions: $EXPECTED_SESSIONS, panes: $EXPECTED_PANES"
}

show_inventory
if [[ "$DRY_RUN" == true ]]; then
  exit 0
fi

if [[ -n "$SNAPSHOT_DIR_ARG" ]]; then
  load_snapshot
  echo 'Stopping current tmux server before snapshot restore...'
  "$TMUX_BIN" kill-server || true
else
  [[ -f "$SAVE_SCRIPT" ]] || fatal "tmux-resurrect save script not found: $SAVE_SCRIPT"
  snapshot_state
  echo 'Saving tmux-resurrect snapshot...'
  bash "$SAVE_SCRIPT"
  echo 'Stopping tmux server...'
  "$TMUX_BIN" kill-server || true
fi

# rcon uses zsh + the full user PATH before starting the server. Do the same.
export RCON_HOST_HOME="$HOME"
export RCON_HOST_MACHINE="${RCON_HOST_MACHINE:-$(hostname -s 2>/dev/null || hostname)}"
start_server
restore_layout
restore_args=("$SNAPSHOT_DIR")
[[ -n "$SNAPSHOT_DIR_ARG" ]] && restore_args+=(--force)
TMUX_BIN="$TMUX_BIN" TMUX_RESTART_STATE_DIR="$STATE_DIR" \
  "$SCRIPT_DIR/tmux-restore-extras.sh" restore "${restore_args[@]}"

if [[ "$NO_ATTACH" == false ]]; then
  exec "$TMUX_BIN" attach-session -t "$ATTACH_SESSION"
fi

echo "Restored. Attach with: tmux attach -t $(shell_quote "$ATTACH_SESSION")"
