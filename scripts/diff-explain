.hljs-comment,.hljs-quote { color:#8b949e; font-style:italic; }
.hljs-keyword,.hljs-selector-tag,.hljs-literal,.hljs-section,.hljs-doctag,.hljs-type,.hljs-name,.hljs-strong { color:#ff7b72; }
