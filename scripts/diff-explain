.overview ul, .overview ol { margin:8px 0; padding-left:22px; }
.overview li { margin:3px 0; }
.overview a { color:var(--hl); }
.overview hr { border:none; border-top:1px solid var(--line); margin:18px 0; }
.overview blockquote { margin:8px 0; padding-left:12px; border-left:3px solid var(--line); color:var(--dim); }
.overview pre { background:#0b0e13; border:1px solid var(--line); border-radius:6px;
                padding:10px 12px; overflow:auto; }
.overview code { font-family:ui-monospace,SFMono-Regular,monospace; font-size:12.5px; }
.overview table { width:auto; table-layout:auto; font-family:inherit; font-size:13px; margin:8px 0; }
.overview th, .overview td { border:1px solid var(--line); padding:4px 10px; text-align:left; }
.file { border:1px solid var(--line); border-radius:10px; margin:28px 0; overflow:hidden; }
.file > h2 { position:sticky; top:0; z-index:1; margin:0; padding:10px 16px; font-size:14px;
             background:var(--panel); border-bottom:1px solid var(--line); font-family:ui-monospace,monospace; }
.file .note { margin:12px 16px; }
.hunk { border-top:1px solid var(--line); }
